{
  "name": "questline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Questline — Mochi's Quest Diary (monorepo)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @questline/server & npm run dev -w @questline/client",
    "dev:client": "npm run dev -w @questline/client",
    "dev:server": "npm run dev -w @questline/server",
    "start": "npm run start -w @questline/server",
    "test": "npm run test -w @questline/server && npm run test -w @questline/client",
    "typecheck": "npm run typecheck -w @questline/server && npm run typecheck -w @questline/client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
