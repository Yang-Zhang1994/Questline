# PostgreSQL connection string (required). Issue #17 / #30.
DATABASE_URL=postgres://questline:questline@localhost:5432/questline
# Optional: set to true when Postgres requires TLS (e.g. external managed DB URLs).
DATABASE_SSL=

# API
PORT=3001
# Optional comma-separated allowed Origin(s) for browser CORS.
# In production, cross-origin reflection is disabled unless CORS_ORIGIN is set.
CORS_ORIGIN=

# Demo seed: runs automatically outside production; set SEED_DEMO_DATA=true to seed in production.
SEED_DEMO_DATA=

# Claude (server-side only — never expose to the browser)
# Required in production unless ALLOW_ECHO_AI=true is set explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOW_ECHO_AI=

# JWT auth (Issue #31) — use a random string of ≥32 characters in production
# (production startup rejects this example value and secrets shorter than 32 chars).
# Tokens are returned in JSON and sent back as: Authorization: Bearer <token>
# (Bearer header chosen over httpOnly cookies for simpler API/curl/Supertest use.)
JWT_SECRET=change-me-in-local-dev
