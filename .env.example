# PostgreSQL connection string (required). Issue #17 / #30.
DATABASE_URL=postgres://questline:questline@localhost:5432/questline

# API
PORT=3001

# Claude (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# JWT auth (Issue #31) — use a long random string in real environments.
# Tokens are returned in JSON and sent back as: Authorization: Bearer <token>
# (Bearer header chosen over httpOnly cookies for simpler API/curl/Supertest use.)
JWT_SECRET=change-me-in-local-dev
